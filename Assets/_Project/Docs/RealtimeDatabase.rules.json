{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('UserLevel').val() >= 2)",
        ".validate": "newData.hasChildren(['UserID','UserLevel']) && newData.child('UserID').val() == $uid && ((!data.exists() && newData.child('UserLevel').val() == 1) || (data.exists() && (root.child('users').child(auth.uid).child('UserLevel').val() >= 2 || newData.child('UserLevel').val() == data.child('UserLevel').val())))"
      }
    },

    "friendCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.isString()"
      }
    },

    "usernames": {
      "$username": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.isString()"
      }
    },

    "friendRequests": {
      "$toUid": {
        ".read": "auth != null && auth.uid == $toUid",
        "$fromUid": {
          ".read": "auth != null && (auth.uid == $toUid || auth.uid == $fromUid)",
          ".write": "auth != null && (root.child('users').child(auth.uid).child('UserLevel').val() >= 2 || auth.uid == $fromUid || auth.uid == $toUid)",
          ".validate": "!newData.exists() || (newData.hasChildren(['requestedAt', 'status']) && newData.child('status').val() == 'pending')"
        }
      }
    },

    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$friendUid": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('UserLevel').val() >= 2 || auth.uid == $uid || (auth.uid == $friendUid && (data.exists() || root.child('friendRequests').child($friendUid).child($uid).child('status').val() == 'pending')))",
          ".validate": "!newData.exists() || newData.hasChildren(['addedAt'])"
        }
      }
    },

    "races": {
      ".read": "auth != null",
      "$raceId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('UserLevel').val() >= 2 || (!data.exists() && newData.child('hostId').val() == auth.uid) || (data.exists() && data.child('hostId').val() == auth.uid))",
        "status": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('UserLevel').val() >= 2 || data.parent().child('hostId').val() == auth.uid || (newData.val() == 'completed' && data.val() == 'in_progress' && data.parent().child('participants').child(auth.uid).exists()))"
        },
        "participants": {
          "$participantId": {
            ".write": "auth != null && (root.child('users').child(auth.uid).child('UserLevel').val() >= 2 || data.parent().parent().child('hostId').val() == auth.uid || (auth.uid == $participantId && !newData.exists()) || (auth.uid == $participantId && !data.exists() && root.child('races').child($raceId).child('status').val() == 'open'))",
            "watchedAt": {
              ".write": "auth != null && (root.child('users').child(auth.uid).child('UserLevel').val() >= 2 || data.parent().parent().parent().child('hostId').val() == auth.uid || (auth.uid == $participantId && data.parent().parent().parent().child('status').val() == 'in_progress'))"
            }
          }
        }
      }
    },

    "joinRequests": {
      "$raceId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('UserLevel').val() >= 2 || root.child('races').child($raceId).child('hostId').val() == auth.uid)",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('UserLevel').val() >= 2 || root.child('races').child($raceId).child('hostId').val() == auth.uid)",
        "$requesterId": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('UserLevel').val() >= 2 || auth.uid == $requesterId || root.child('races').child($raceId).child('hostId').val() == auth.uid)",
          ".write": "auth != null && (root.child('users').child(auth.uid).child('UserLevel').val() >= 2 || auth.uid == $requesterId || root.child('races').child($raceId).child('hostId').val() == auth.uid)",
          ".validate": "root.child('users').child(auth.uid).child('UserLevel').val() >= 2 || (auth.uid == $requesterId && (!newData.exists() || newData.child('status').val() == 'pending')) || root.child('races').child($raceId).child('hostId').val() == auth.uid"
        }
      }
    },

    "leaderboard": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['UserName', 'Sex', 'StepCount'])"
      }
    },

    "userRaces": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('UserLevel').val() >= 2)",
        "$raceId": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('UserLevel').val() >= 2 || auth.uid == $uid || root.child('races').child($raceId).child('hostId').val() == auth.uid)"
        }
      }
    },

    "walletTransactions": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('UserLevel').val() >= 2)",
        "$txId": {
          ".write": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('UserLevel').val() >= 2)",
          ".validate": "newData.hasChildren(['type', 'amount', 'status', 'createdAt']) && (newData.child('type').val() == 'earn' || newData.child('type').val() == 'spend' || newData.child('type').val() == 'refund') && (newData.child('status').val() == 'settled' || newData.child('status').val() == 'refunded')"
        }
      }
    },

    "pendingRefunds": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('UserLevel').val() >= 2)",
        "$raceId": {
          ".write": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('UserLevel').val() >= 2 || root.child('races').child($raceId).child('hostId').val() == auth.uid)",
          ".validate": "!newData.exists() || newData.hasChildren(['amount', 'spendTxId', 'createdAt'])"
        }
      }
    }
  }
}
