{
  "rules": {
    ".read": "false",
    ".write": "false",
    "users": {
      "$uid": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('UserLevel').val() >= 1",
        ".write": "(auth != null && (root.child('users').child(auth.uid).child('UserLevel').val() >= 2 || (root.child('users').child(auth.uid).child('UserLevel').val() >= 1 && auth.uid == $uid))) || (auth == null && !data.exists())",
        ".validate": "auth != null || (!data.exists() && newData.child('UserID').val() == $uid && newData.child('UserLevel').val() == 1)"
      }
    },
    "Users": {
      "$userKey": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('UserLevel').val() >= 1",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('UserLevel').val() >= 2 || (root.child('users').child(auth.uid).child('UserLevel').val() >= 1 && (newData.child('UserID').val() == auth.uid || data.child('UserID').val() == auth.uid)))"
      }
    },
    "races": {
      "$raceId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('UserLevel').val() >= 1",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('UserLevel').val() >= 2 || (root.child('users').child(auth.uid).child('UserLevel').val() >= 1 && ((!data.exists() && newData.child('hostId').val() == auth.uid) || data.child('hostId').val() == auth.uid)))",
        "participants": {
          "$participantId": {
            ".write": "auth != null && (root.child('users').child(auth.uid).child('UserLevel').val() >= 2 || root.child('races').child($raceId).child('hostId').val() == auth.uid || (root.child('users').child(auth.uid).child('UserLevel').val() >= 1 && auth.uid == $participantId && !newData.exists()))"
          }
        }
      }
    },
    "joinRequests": {
      "$raceId": {
        "$requesterId": {
          ".read": "auth != null && root.child('users').child(auth.uid).child('UserLevel').val() >= 1 && (root.child('users').child(auth.uid).child('UserLevel').val() >= 2 || auth.uid == $requesterId || root.child('races').child($raceId).child('hostId').val() == auth.uid)",
          ".write": "auth != null && root.child('users').child(auth.uid).child('UserLevel').val() >= 1 && (root.child('users').child(auth.uid).child('UserLevel').val() >= 2 || auth.uid == $requesterId || root.child('races').child($raceId).child('hostId').val() == auth.uid)",
          ".validate": "root.child('users').child(auth.uid).child('UserLevel').val() >= 2 || (auth.uid == $requesterId && (!newData.exists() || newData.child('status').val() == 'pending')) || (root.child('races').child($raceId).child('hostId').val() == auth.uid)"
        }
      }
    },
    "userRaces": {
      "$uid": {
        "$raceId": {
          ".read": "auth != null && root.child('users').child(auth.uid).child('UserLevel').val() >= 1 && (auth.uid == $uid || root.child('users').child(auth.uid).child('UserLevel').val() >= 2)",
          ".write": "auth != null && root.child('users').child(auth.uid).child('UserLevel').val() >= 1 && (root.child('users').child(auth.uid).child('UserLevel').val() >= 2 || auth.uid == $uid || root.child('races').child($raceId).child('hostId').val() == auth.uid)"
        }
      }
    }
  }
}
