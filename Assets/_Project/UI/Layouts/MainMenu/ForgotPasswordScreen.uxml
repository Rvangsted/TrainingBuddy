<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/Styles/Stylesheets/ForgotPasswordScreen.uss?fileID=7433441132597879392&amp;guid=72154dae9bb945b3a64a42d0323c09f1&amp;type=3#ForgotPasswordScreen"/>
    <ui:VisualElement name="ForgotPasswordScreen" class="forgot-password-screen">
        <ui:VisualElement name="MainContainer" class="main-container">
            <TrainingBuddy.UI.Controls.LocalizedLabel key="text_forgot_password" name="Title" class="font-title forgot-password-title"/>
            <TrainingBuddy.UI.Controls.LocalizedLabel key="text_forgot_password_subtitle" name="SubTitle" class="forgot-password-sub-title"/>
            <TrainingBuddy.UI.Controls.LocalizedTextInput name="Email" key="text_email" hide-placeholder-on-focus="true" class="field-email"/>
            <TrainingBuddy.UI.Controls.LocalizedButton key="button_reset_password" name="ForgotPasswordButton" class="button-large alt-button reset-button"/>
        </ui:VisualElement>
        <ui:VisualElement name="BottomLink" class="bottom-link-container">
            <TrainingBuddy.UI.Controls.LocalizedLabel name="MissingAccount" key="text_need_account_prompt" class="bottom-link-label"/>
            <TrainingBuddy.UI.Controls.LocalizedButton name="RegisterAccount" key="button_register_user" class="text-button bottom-link-button"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
