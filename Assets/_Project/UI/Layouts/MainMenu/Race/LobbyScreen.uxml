<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/Styles/Stylesheets/Race/LobbyScreen.uss?fileID=7433441132597879392&amp;guid=8c76b440ac30481b97a90b168f0487d8&amp;type=3#LobbyScreen"/>
    <ui:VisualElement name="LobbyScreen" class="lobby-screen" style="flex-grow: 1;">
        <ui:VisualElement name="Container" class="container" style="flex-grow: 1;">
            <ui:VisualElement name="SearchRow" class="search-row">
                <TrainingBuddy.UI.Controls.LocalizedTextInput name="SearchField" key="text_searchfield" hide-placeholder-on-focus="true" class="field-searchfield"/>
                <ui:Button text="" name="FilterButton" class="filter-button"/>
            </ui:VisualElement>
            <ui:ScrollView name="LobbyList" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" class="lobby-scroll" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
