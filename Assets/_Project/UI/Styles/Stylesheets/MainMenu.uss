.main-menu-wrapper {
    flex-grow: 1;
    width: 100%;
    justify-content: flex-end;
    align-items: center;
    padding: 24px 0;
}

.main-menu {
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    width: 100%;
    max-width: 320px;
    flex-grow: 1;
}

.main-menu #PrivacyButton {
    height: 30px;
    margin-top: 24px;
}

.drop-shadow {
    width: 100%;
    align-self: center;
    flex-grow: 1;
    flex-shrink: 0;
}

.gradient-container {
    position: relative;
    align-items: center;
    flex-shrink: 0;
    border-radius: 54px;
    background-color: white;
    --gradient-from: rgba(255, 255, 255, 1);
    --gradient-to: rgba(96, 85, 255, .1);
    --gradient-direction: vertical;
}

.shadow-button {
    margin-top: 24px;
}

.gradient-container .content {
    align-items: center;
}

.button-large {
    position: relative;
}
