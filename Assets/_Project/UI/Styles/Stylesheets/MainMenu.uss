.main-menu-wrapper {
    height: 100%;
    width: 100%;
}

.main-menu {
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    margin-bottom: 55px;
    height: 100%;
}

.button-large {
    position: relative;
    margin: 14px 0;
    font-size: var(--font-size-main-menu);
}

.privacy-button {
    align-self: center;
    color: white;
}