/*General*/
.profile-screen {
    height: 100%;
    width: 100%;
}

.profile-wrapper {
    width: 100%;
    height: 100%;
}

.profile-screen .profile-picture-big {
    position: absolute;
    background-image: url('project://database/Assets/_Project/Art/Characters/emma_figur_1.png');
    background-position-y: top 0;
    background-size: auto 488px;
    width: 328px;
    height: 488px;
    left: -175px;
    top: -10px;
}

.profile-screen .profile-picture-big.Mand {
    background-image: url('project://database/Assets/_Project/Art/Characters/emil_figur_1.png');
    width: 400px;
    left: -178px;
    top: 18px;
}

.profile-screen .profile-picture-big.Kvinde {
    background-image: url('project://database/Assets/_Project/Art/Characters/emma_figur_1.png');
}

/*Info Container*/
.info-wrapper {
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    margin-top: 22px;
}

.info-container {
    position: relative;
    flex-direction: row;
    align-items: center;
    background-color: var(--color-buttons);
    height: 86px;
    width: 319px;
    border-radius: 50px;
}

.info-container .middle-labels {
    justify-content: center;
    flex-grow: 1;
    height: 100%;
    margin-left: 100px;
    overflow: hidden;
}

.info-container .middle-labels .name-label {
    font-size: var(--font-size-l);
}

.info-container .middle-labels .date-of-birth-label {
    padding: 10px 0;
    font-size: var(--font-size-m);
}

.info-container .middle-labels .user-id-label {
    font-size: var(--font-size-xs);
}

.info-container .edit-button {
    width: 60px;
    height: 60px;
    background-color: var(--color-buttons);
    border-color: black;
    border-width: 1px;
    border-radius: 50%;
    background-image: url('project://database/Assets/_Project/Art/Icons/edit.png');
    background-size: 40px;
    -unity-background-image-tint-color: var(--color-dark);
    margin-right: -5px;
}

/*Stats Container*/
.stats-container {
    position: relative;
    flex-direction: row;
    align-items: flex-start;
    background-color: var(--color-white);
    border-color: black;
    border-width: 1px;
    border-radius: 50px;
    margin-top: 20px;
    padding-bottom: 30px;
}

/* Leveling */
.stats-container .leveling-container {
    flex-grow: 1;
}

.stats-container .leveling-container .leveling-top-container {
    width: 100%;
    flex-direction: row;
}

.stats-container .leveling-container .leveling-top-container .leveling-top-left-container {
    flex-grow: 1;
}

/* Unused */
.stats-container .leveling-container .leveling-top-container .leveling-top-left-container .leveling-top-left-element {
    display: none;
    margin: 30px 0 0 30px;
    width: 80px;
    height: 80px;
    background-color: var(--color-buttons);
    border-width: 0;
    border-radius: 50%;
}

.stats-container .leveling-container .leveling-top-container .leveling-top-right-container {
    flex-grow: 1;
    align-items: flex-end;
}

.stats-container .leveling-container .leveling-top-container .leveling-top-right-container .leveling-points-container {
    margin: 15px 15px 0 0;
    width: 60px;
    height: 60px;
    background-color: var(--color-buttons);
    border-width: 0;
    border-radius: 50%;
    justify-content: center;
}

.stats-container .leveling-container .leveling-top-container .leveling-top-right-container .leveling-points-container .leveling-points-label {
    /*display: none;*/
    -unity-text-align: middle-center;
}

.stats-container .leveling-container .leveling-top-container .leveling-top-right-container .leveling-points-container .leveling-points-label.font-title {
    font-size: var(--font-size-xl);
}

.stats-container .leveling-container .leveling-top-container .leveling-top-right-container .leveling-points-container .leveling-points-label.font-regular {
    font-size: var(--font-size-l);
}

.stats-container .leveling-container .leveling-middle-container {
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    margin-top: -25px;
}

.stats-container .leveling-container .leveling-middle-container .leveling-progress-wrapper {
    position: relative;
    justify-content: center;
    align-items: center;
    width: 260px;
    height: 260px;
}

.stats-container .leveling-container .leveling-middle-container .leveling-progress-wrapper .leveling-progress-bar {
    position: absolute;
    width: 253px;
    height: 253px;
}

.stats-container .leveling-container .leveling-middle-container .leveling-progress-wrapper .leveling-progress-content {
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 70%;
    height: 70%;
    border-radius: 50%;
}

.stats-container .leveling-container .leveling-middle-container .leveling-progress-wrapper .leveling-progress-content .leveling-progress-value-label {
    font-size: 26px;
    color: var(--color-dark);
    -unity-text-align: middle-center;
}

.stats-container .leveling-container .leveling-middle-container .leveling-progress-wrapper .leveling-progress-content .leveling-progress-subtitle-label {
    font-size: var(--font-size-xs);
    color: var(--color-font);
}

.stats-container .leveling-container .leveling-bottom-container {
    min-height: 100px;
    width: 100%;
    flex-direction: row;
    margin-top: -40px;
}

.stats-container .leveling-container .leveling-bottom-container .leveling-bottom-left-container {
    flex-grow: 1;
}

/* Unused */
.stats-container .leveling-container .leveling-bottom-container .leveling-bottom-left-container .leveling-bottom-left-element {
    display: none;
    margin: 0 0 15px 15px;
    width: 60px;
    height: 60px;
    background-color: var(--color-buttons);
    border-width: 0;
    border-radius: 50%;
}

.stats-container .leveling-container .leveling-bottom-container .leveling-bottom-left-container .leveling-bottom-left-element .leveling-bottom-left-element-label {
    display: none;
}

.stats-container .leveling-container .leveling-bottom-container .leveling-bottom-right-container {
    display: none;
    flex-grow: 1;
    align-items: flex-end;
    justify-content: flex-end;
}

.stats-container .leveling-container .leveling-bottom-container .leveling-bottom-right-container .leveling-bottom-right-element {
    margin: 0 15px 20px 0;
    width: 60px;
    height: 60px;
    background-color: var(--color-buttons);
    border-width: 0;
    border-radius: 50%;
    background-image: url('project://database/Assets/_Project/Art/Icons/cap.png');
    background-size: 40px;
}

.stats-container .leveling-container .leveling-bottom-container .leveling-bottom-right-container .leveling-bottom-right-element .leveling-bottom-right-element-label {
    display: none;
}

/* Stats */
.stats-container .speed-stat-container,
.stats-container .acceleration-stat-container {
    flex-grow: 1;
}

.stats-container .speed-stat-container .speed-stat-title,
.stats-container .acceleration-stat-container .acceleration-stat-title {
    flex-grow: 1;
    font-size: var(--font-size-xl);
    padding: 5px 20px;
}

.stats-container .speed-stat-container .speed-stat-subtitle,
.stats-container .acceleration-stat-container .acceleration-stat-subtitle {
    flex-grow: 1;
    font-size: var(--font-size-m);
    padding: 5px 20px 15px 20px;
}

.stats-container .speed-stat-container .speed-stat-upper,
.stats-container .acceleration-stat-container .acceleration-stat-upper {
    flex-grow: 1;
    flex-direction: row;
}

.stats-container .speed-stat-container .speed-stat-upper .speed-stat-left,
.stats-container .acceleration-stat-container .acceleration-stat-upper .acceleration-stat-left{
    flex-grow: 1;
    background-image: url('project://database/Assets/_Project/Art/Icons/turtle.png');
    background-size: 38px auto;
    background-position-x: right 10px;
}

.stats-container .speed-stat-container .speed-stat-upper .speed-stat-middle,
.stats-container .acceleration-stat-container .acceleration-stat-upper .acceleration-stat-middle {
    width: 246px;
    min-height: 20px;
}

.stats-container .speed-stat-container .speed-stat-upper .speed-stat-middle .linear-progress-bar,
.stats-container .acceleration-stat-container .acceleration-stat-upper .acceleration-stat-middle .linear-progress-bar {
    width: 100%;
    height: 20px;
    margin: 10px 0;
}

.stats-container .speed-stat-container .speed-stat-upper .speed-stat-right,
.stats-container .acceleration-stat-container .acceleration-stat-upper .acceleration-stat-right {
    flex-grow: 1;
    background-image: url('project://database/Assets/_Project/Art/Icons/hare.png');
    background-size: auto 34px;
    background-position-x: left 10px;
}

.stats-container .speed-stat-container .speed-stat-lower,
.stats-container .acceleration-stat-container .acceleration-stat-lower {
    flex-grow: 1;
    flex-direction: row;
}

.stats-container .speed-stat-container .speed-stat-lower .speed-stat-left,
.stats-container .acceleration-stat-container .acceleration-stat-lower .acceleration-stat-left {
    flex-grow: 1;
    height: 40px;
    background-image: url('project://database/Assets/_Project/Art/Icons/minus.png');
    background-size: 29px 7px;
    background-position-y: center;
    background-position-x: right 18px;
    width: auto;
    border-radius: 0;
    background-color: rgba(0,0,0,0);
}

.stats-container .speed-stat-container .speed-stat-lower .speed-stat-middle,
.stats-container .acceleration-stat-container .acceleration-stat-lower .acceleration-stat-middle {
    width: 246px;
    justify-content: center;
}

.stats-container .speed-stat-container .speed-stat-lower .speed-stat-middle .speed-stat-value,
.stats-container .acceleration-stat-container .acceleration-stat-lower .acceleration-stat-middle .acceleration-stat-value {
    font-size: var(--font-size-m);
    align-self: center;
}

.stats-container .speed-stat-container .speed-stat-lower .speed-stat-right,
.stats-container .acceleration-stat-container .acceleration-stat-lower .acceleration-stat-right {
    flex-grow: 1;
    height: 40px;
    background-image: url('project://database/Assets/_Project/Art/Icons/plus.png');
    background-size: 29px 29px;
    background-position-y: center;
    background-position-x: left 13px;
    width: auto;
    border-radius: 0;
    background-color: rgba(0,0,0,0);
}

/*Activity Container*/
.activity-container {
    margin-top: 20px;
    display: flex;
    flex-direction: column;
    padding-bottom: 12px;
}

.activity-container .activity-header {
    flex-direction: column;
}

.activity-container .activity-title {
    flex-grow: 1;
    font-size: var(--font-size-xl);
    padding: 5px 20px 0 20px;
}

.activity-container .activity-subtitle {
    flex-grow: 1;
    font-size: var(--font-size-m);
    padding: 2px 20px 18px 20px;
    opacity: 0.65;
}

.activity-container .activity-graph {
    width: 100%;
    margin-top: 6px;
}

.activity-graph {
    --activity-graph-fill-top-color: rgba(194, 144, 255, 0.50);
    --activity-graph-fill-bottom-color: rgba(194, 144, 255, 0.04);
    --activity-graph-stroke-color: rgba(138, 83, 241, 0.14);
    --activity-graph-stroke-width: 4;
    --activity-graph-highlight-line-color: rgba(39, 39, 39, 0.18);
    --activity-graph-highlight-line-width: 4;
    --activity-graph-highlight-dash-length: 18;
    --activity-graph-highlight-dash-gap: 16;
    --activity-graph-highlight-dot-color: rgb(39, 39, 39);
    --activity-graph-highlight-dot-size: 8;
    --activity-graph-value-label-offset: 19;
    --activity-graph-top-padding: 56;
    --activity-graph-horizontal-plot-padding: 18;
    height: 260px;
    position: relative;
    flex-direction: column;
    padding: 0;
}

.activity-graph__canvas {
    position: relative;
    flex-grow: 1;
    height: 188px;
}

.activity-graph__highlight-dot {
    width: 8px;
    height: 8px;
    background-color: rgb(39, 39, 39);
    border-radius: 50%;
}

.activity-graph__value-label {
    color: rgb(39, 39, 39);
    font-size: 15px;
    -unity-font-definition: url("project://database/Assets/_Project/Fonts/Bungee/Bungee-Regular SDF.asset");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.activity-graph__labels {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 20px;
    padding: 0 18px;
}

.activity-graph__labels .activity-graph__label {
    font-size: 11px;
    color: rgba(0, 0, 0, 0.78);
    -unity-text-align: middle-center;
}

/*Friends Container*/
.friends-container {
    margin-top: 20px;
    display: flex;
    flex-direction: column;
}

.friends-container .friend-title {
    flex-grow: 1;
    font-size: var(--font-size-xl);
    padding: 5px 20px;
}

.friends-container .friend-subtitle {
    flex-grow: 1;
    font-size: var(--font-size-m);
    padding: 5px 20px 15px 20px;
}

.friends-container .friends-content {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 40px;
}

.friends-container .friend-element {
    position: relative;
    background-color: var(--color-buttons);
    align-items: center;
    justify-content: flex-end;
    width: 79px;
    height: 103px;
    border-radius: 15px;
    margin: 20px 43px 20px 0;
}

.friends-container .friend-element.no-margin {
    margin-right: 0;
}

.friends-container .friends-content .friend-element .friend-image {
    position: absolute;
    width: 100px;
    height: 100px;
    top: -28px;
    background-image: url('project://database/Assets/_Project/Art/Characters/emma_friend.png');
    background-size: 100px;
}

.friends-container .friends-content .friend-element .friend-favorite-icon {
    position: absolute;
    width: 39px;
    height: 39px;
    top: -28px;
    right: -20px;
    background-image: url('project://database/Assets/_Project/Art/icons/favorite_star.png');
    background-size: 39px;
}

.friends-container .friends-content .friend-element .friend-name-label {
    font-size: var(--font-size-xs);
    margin-bottom: 1px;
}

.friends-container .friends-content .friend-element .friend-distance-label {
    font-size: var(--font-size-xs);
    margin-bottom: 5px;
}

/*Menu Container*/
.menu-container {
    margin: 0 30px;
    align-items: center;
    /*display: none;*/
}

.menu-container .unity-button {
    margin-bottom: 10px;
}

.privacy-button {
    margin-top: 10px;
}
