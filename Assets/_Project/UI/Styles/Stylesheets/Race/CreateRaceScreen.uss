.create-race-wrapper {
    flex-grow: 1;
    width: 100%;
}

.create-race-screen {
    width: 100%;
    height: 100%;
}

.create-race-screen .container {
    padding: 22px 24px 24px;
    align-items: center;
}

.create-race-title {
    font-size: var(--font-size-xl);
    color: var(--color-dark);
    margin-bottom: 21px;
}

.field-race-name {
    width: 325px;
    height: 52px;
    margin-bottom: 21px;
}

.section-container {
    width: 325px;
    margin-bottom: 21px;
}

.section-label {
    font-size: var(--font-size-m);
    margin: 0 0 8px 5px;
    color: var(--color-font);
}

.tier-group .unity-radio-button-group__container {
    flex-direction: column;
}

.tier-group .unity-base-field__input {
    border-width: 0;
}

.tier-group .unity-radio-button {
    border-width: 1px;
    border-color: rgba(227, 227, 227, 1);
    border-radius: 15px;
    padding: 8px 12px;
    margin-bottom: 8px;
}

.tier-group .unity-radio-button__text {
    font-size: var(--font-size-m);
    color: var(--color-font);
    white-space: normal;
}

.create-race-button {
    margin-top: 10px;
}
