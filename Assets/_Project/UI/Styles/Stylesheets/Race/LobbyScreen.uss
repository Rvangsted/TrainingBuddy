.lobby-wrapper {
    width: 100%;
    height: 100%;
}

.lobby-screen {
    width: 100%;
    height: 100%;
}

.lobby-screen .container {
    padding: 22px 24px 24px;
    align-items: center;
}

.search-row {
    width: 100%;
    flex-direction: row;
    align-items: center;
    margin-bottom: 18px;
}

.search-shell {
    flex-grow: 1;
    height: 52px;
    justify-content: center;
    padding-left: 26px;
    margin-right: 14px;
    border-radius: 26px;
    background-color: var(--color-white);
    border-width: 1px;
    border-color: rgba(225, 225, 225, 1);
}

.search-placeholder {
    font-size: 19px;
    color: rgba(205, 205, 205, 1);
}

.filter-button {
    width: 72px;
    height: 72px;
    align-items: center;
    justify-content: center;
    border-radius: 36px;
    background-color: var(--color-white);
    border-width: 1px;
    border-color: rgba(225, 225, 225, 1);
}

.filter-icon {
    width: 32px;
    height: 28px;
    justify-content: space-between;
}

.filter-icon__line {
    height: 4px;
    border-radius: 2px;
    background-color: rgba(58, 58, 58, 1);
    align-self: center;
}

.filter-icon__line--short {
    width: 18px;
}

.filter-icon__line--medium {
    width: 24px;
}

.filter-icon__line--long {
    width: 32px;
}

.lobby-scroll {
    width: 100%;
    flex-grow: 1;
}

.lobby-scroll > .unity-scroll-view__content-container {
    padding-top: 4px;
    padding-bottom: 12px;
}

.lobby-card-row {
    position: relative;
    width: 100%;
    height: 118px;
    margin-bottom: 16px;
}

.lobby-card {
    position: absolute;
    left: 12px;
    right: 12px;
    top: 10px;
    bottom: 10px;
    padding-left: 108px;
    padding-right: 92px;
    justify-content: center;
    border-radius: 32px;
    background-color: var(--color-white);
    border-width: 1px;
    border-color: rgba(227, 227, 227, 1);
}

.lobby-card__content {
    justify-content: center;
}

.lobby-card__title {
    font-size: 21px;
    margin-bottom: 4px;
}

.lobby-card__host {
    font-size: 13px;
    color: rgba(171, 171, 171, 1);
    margin-bottom: 2px;
}

.lobby-card__start {
    font-size: 11px;
    color: rgba(181, 181, 181, 1);
}

.lobby-card__avatar {
    position: absolute;
    left: 0;
    top: 0;
    width: 98px;
    height: 98px;
    background-position: center;
    background-repeat: no-repeat;
    background-size: contain;
}

.lobby-card__avatar--emil {
    background-image: url('project://database/Assets/_Project/Art/Characters/emil_figur_1.png');
}

.lobby-card__avatar--emma {
    background-image: url('project://database/Assets/_Project/Art/Characters/emma_figur_1.png');
}

.lobby-card__action {
    position: absolute;
    right: 0;
    top: 23px;
    width: 72px;
    height: 72px;
    align-items: center;
    justify-content: center;
    border-radius: 36px;
    background-color: var(--color-white);
    border-width: 1px;
    border-color: rgba(225, 225, 225, 1);
}

.lobby-card__action-icon {
    font-size: 38px;
    color: var(--color-magenta);
    margin-left: 6px;
    margin-top: -2px;
}
