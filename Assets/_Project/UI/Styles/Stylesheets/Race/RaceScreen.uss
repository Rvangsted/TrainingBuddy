.race-wrapper {
    width: 100%;
    height: 100%;
}

.race-screen {
    width: 100%;
    height: 100%;
    justify-content: flex-end;
}

/* ── Race Screen ── */

.race-progress-bar {
    width: 100%;
    align-items: center;
}

.progress-track {
    width: 280px;
    height: 33px;
    background-image: url('project://database/Assets/_Project/Art/race_progress.png');
}

.player-icons-container {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: visible;
}

/* Pin = name label stacked above the avatar icon */
.player-pin {
    position: absolute;
    align-items: center;
    overflow: visible;
    /* top: name(~14px) + gap(4px) + half-icon(22px) - half-track(7px) = -33px above track top */
    top: -14px;
}

.player-name {
    display: none;
    font-size: var(--font-size-xs);
    color: var(--color-dark);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: visible;
    margin-bottom: 3px;
}

.player-icon {
    width: 58px;
    height: 50px;
    background-position: center;
}

/* Avatar images */
.avatar-male {
    background-image: url('project://database/Assets/_Project/Art/Icons/emil_icon.png');
    background-size: 48px 42px;
    background-position-x: center;
    background-position-y: bottom 0;
}

.avatar-female {
    background-image: url('project://database/Assets/_Project/Art/Icons/emma_icon.png');
    background-size: 58px 50px;
}

/* Coloured border per player slot */
.player-color-0 { border-color: var(--color-lime); }
.player-color-1 { border-color: var(--color-magenta); }
.player-color-2 { border-color: var(--color-blue); }
.player-color-3 { border-color: var(--color-red); }
.player-color-4 { border-color: var(--color-orange); }
.player-color-5 { border-color: var(--color-olive); }
