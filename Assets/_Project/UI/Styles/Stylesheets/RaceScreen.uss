.race-menu-wrapper,
.race-wrapper,
.find-lobby-wrapper,
.host-wrapper,
.lobby-wrapper {
    flex-grow: 1;
    width: 100%;
    align-items: center;
    padding: 24px 0;
}

.race-screen {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    width: 100%;
    max-width: 320px;
}

.button-large {
    margin-top: 12px;
}

.title {
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 16px;
}

.container {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 300px;
    max-width: 100%;
    gap: 12px;
    padding: 24px 0;
}
