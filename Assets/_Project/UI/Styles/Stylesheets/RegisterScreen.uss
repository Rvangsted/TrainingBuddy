.register-wrapper {
    flex-grow: 1;
    width: 100%;
    align-items: center;
}

.register-screen {
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    height: 100%;
    width: 100%;
    max-width: 320px;
}

.main-container {
    width: 100%;
}

.register-title {
    width: 100%;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 11px;
}

.register-sub-title {
    -unity-text-align: middle-center;
    font-size: var(--font-size-xs);
    margin-bottom: 37px;
}

.field-username {
    width: 325px;
    height: 52px;
    margin-bottom: 21px;
}

.field-email {
    width: 325px;
    height: 52px;
    margin-bottom: 21px;
}

.field-password {
    width: 325px;
    height: 52px;
}

.forgot-password {
    color: var(--color-magenta);
    align-self: flex-end;
    margin-top: 9px;
}

.register-button {
    margin-bottom: 48px;
    margin-top: 21px;
}

/* Separator */
.separator-container {
    height: 15px;
    width: 100%;
    flex-direction: row;
}

.box-left, .box-right {
    border-top-width: 1px;
    border-top-color: var(--color-separator);
    flex: 1;
}

.register-options-title {
    font-size: var(--font-size-xs);
    -unity-text-align: upper-center;
    margin: -5px 30px 5px 30px;
}

/* Register Options */
.register-options-container {
    height: 118px;
}

.facebook-button {

}

.google {

}

.apple {

}

/* Bottom Link */
.bottom-link-container {
    display: flex;
    flex-direction: row;
}

.bottom-link-label {
    font-size: var(--font-size-xs);
}

.bottom-link-button {
    margin-left: 5px;
    color: var(--color-magenta);
}