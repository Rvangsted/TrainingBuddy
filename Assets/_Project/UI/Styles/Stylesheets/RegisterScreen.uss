.register-wrapper {
    flex-grow: 1;
    width: 100%;
    align-items: center;
}

.register-screen {
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    height: 100%;
    width: 100%;
    max-width: 333px;
    margin-top: 45px;
}

.main-container {
    width: 100%;
}

.register-title {
    width: 100%;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 11px;
}

.register-sub-title {
    -unity-text-align: middle-center;
    font-size: var(--font-size-xs);
    margin-bottom: 37px;
}

.field-username {
    width: 325px;
    height: 52px;
    margin-bottom: 21px;
}

.field-email {
    width: 325px;
    height: 52px;
    margin-bottom: 21px;
}

.field-password {
    width: 325px;
    height: 52px;
}

.field-password-confirm {
    width: 325px;
    height: 52px;
    margin-top: 21px;
}

/* Section (gender / date of birth) */
.section-container {
    width: 325px;
    margin-top: 21px;
}

.section-label {
    font-size: var(--font-size-m);
    margin: 0 0 8px 5px;
    color: var(--color-font);
}

/* Gender radio group */
.gender-group {
    flex-direction: row;
    width: 100%;
}

.gender-group .unity-radio-button-group__container {
    flex-direction: row;
}

.gender-group .unity-base-field__input {
    border-width: 0;
}

.gender-group .unity-radio-button {
    flex-grow: 1;
    border-width: 0;
}

.gender-group .unity-radio-button .unity-radio-button__text {
    font-size: var(--font-size-xl);
    color: var(--color-separator);
    -unity-text-align: middle-center;
    padding: 4px 0 0 5px;
}

/* Date of birth row */
.dob-row {
    flex-direction: row;
    width: 100%;
}

.dob-field {
    flex: 1;
    height: 52px;
    margin-right: 10px;
}

.dob-field:last-child {
    margin-right: 0;
}

.dob-field-year {
    flex: 2;
}

.dob-field .unity-base-field__input {
    height: 100%;
    border-radius: 10px;
    border-color: var(--color-input-field);
    font-size: var(--font-size-m);
    -unity-text-align: middle-center;
}

.forgot-password {
    color: var(--color-magenta);
    align-self: flex-end;
    margin-top: 9px;
}

.register-button {
    margin-bottom: 48px;
    margin-top: 21px;
}

/* Separator */
.separator-container {
    height: 15px;
    width: 100%;
    flex-direction: row;
}

.box-left, .box-right {
    border-top-width: 1px;
    border-top-color: var(--color-separator);
    flex: 1;
}

.register-options-title {
    font-size: var(--font-size-xs);
    -unity-text-align: upper-center;
    margin: -5px 30px 5px 30px;
}

/* Register Options */
.register-options-container {
    height: 118px;
}

.facebook-button {

}

.google {

}

.apple {

}

/* Bottom Link */
.bottom-link-container {
    display: flex;
    flex-direction: row;
}

.bottom-link-label {
    font-size: var(--font-size-xs);
}

.bottom-link-button {
    margin-left: 5px;
    color: var(--color-magenta);
}